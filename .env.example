# Copy to .env for local development. In production, set these as
# environment variables on the host (Railway, Coolify, etc.) instead.

# --- Database ---------------------------------------------------------
# SQLite file. Locally the default is fine; in production it must point
# at a file on persistent storage (e.g. a mounted volume at /data),
# otherwise the database is wiped on every redeploy.
#   local:      file:./dev.db
#   production: file:/data/prod.db
DATABASE_URL="file:./dev.db"

# --- Local storage ----------------------------------------------------
# Base directory for submission uploads, form images (storageProvider =
# "local") and super-admins.txt. Defaults to the app's working directory
# when unset. In production, set it to the persistent volume mount.
#   production: /data
# LOCAL_STORAGE_ROOT=/data

# --- Auth.js ----------------------------------------------------------
# Random secret used to sign session tokens. Generate one with:
#   npx auth secret
#   (or) openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the app. Needed behind a proxy (Railway etc.), where
# Auth.js would otherwise build callback URLs from the internal
# host/port (e.g. localhost:8080). Leave unset for local development.
#   production: https://form.codactics.com
# AUTH_URL=https://form.codactics.com

# Google OAuth client (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI must include:
#   http://localhost:3000/api/auth/callback/google        (local)
#   https://your-domain.com/api/auth/callback/google      (production)
# The Google Drive API and Google Sheets API must be enabled.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Site -------------------------------------------------------------
# Public base URL, used for canonical links, sitemap and robots.txt.
# Defaults to https://form.codactics.com when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
